{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test:multiplayer": "node --test scripts/test-multiplayer.mjs",
    "test:multiplayer-browser": "node scripts/test-multiplayer-browser.mjs",
    "test:multiplayer-gameplay-browser": "node scripts/test-multiplayer-gameplay-browser.mjs",
    "test:multiplayer-slice-browser": "node scripts/test-multiplayer-slice-browser.mjs",
    "test:game-core": "node --experimental-strip-types --test scripts/test-game-core.mjs",
    "test:progression": "node scripts/test-progression-data-model.mjs",
    "admin:maps": "node --experimental-strip-types scripts/map-studio/server.mjs",
    "test:map-studio": "node --experimental-strip-types --test scripts/map-studio/test.mjs",
    "test:map-versions-browser": "node scripts/test-map-versions-browser.mjs",
    "admin:sprites": "node scripts/sprite-studio/server.mjs",
    "test:sprite-studio": "node --test scripts/sprite-studio/test.mjs",
    "admin:characters": "node scripts/character-admin/server.mjs",
    "test:character-admin": "node --test scripts/character-admin/test.mjs",
    "admin:loading": "node scripts/loading-admin/server.mjs",
    "test:loading-admin": "node --test scripts/loading-admin/test.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "node scripts/build-studio-runtime.mjs && node --experimental-strip-types scripts/build-map-runtime.mjs && vite build --config vite.github.config.ts",
    "maps:runtime": "node --experimental-strip-types scripts/build-map-runtime.mjs",
    "test:map-runtime": "node --test scripts/test-map-runtime.mjs",
    "sprites:runtime": "node scripts/build-studio-runtime.mjs",
    "ui:build": "node scripts/build-ui-assets.mjs && node scripts/build-preview-refresh.mjs && node scripts/build-credits.mjs",
    "fields:build": "node scripts/build-field-assets.mjs",
    "fields:baseline": "node scripts/update-field-baseline.mjs",
    "sprites:build": "node scripts/build-jago-source.mjs && node scripts/build-sprites.mjs && node scripts/build-series-sprites.mjs && node scripts/build-kaka-ultimate.mjs && node scripts/build-vfx.mjs && node scripts/build-web-assets.mjs",
    "sprites:series": "node scripts/build-series-sprites.mjs",
    "ultimate:kaka:build": "node scripts/build-kaka-ultimate.mjs",
    "sprites:baseline": "node scripts/update-sprite-baseline.mjs",
    "audit": "node --experimental-strip-types scripts/audit-game.mjs && node --experimental-strip-types scripts/test-series-sprites.mjs && node --experimental-strip-types scripts/test-kampung3d.mjs",
    "verify:runtime": "node scripts/verify-runtime-build.mjs",
    "verify": "npm run ui:build && npm run fields:build && npm run sprites:build && npm run audit && npm run build && npm run verify:runtime && npm run build:pages",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "check": "npx tsc --noEmit && npm run lint && npm run audit && npm run build:pages",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@trystero-p2p/mqtt": "0.26.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "0.186.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
